{
  "name": "cbs-mint",
  "private": true,
  "type": "module",
  "dependencies": {
    "@solana/web3.js": "1.95.3",
    "@metaplex-foundation/umi": "0.10.6",
    "@metaplex-foundation/umi-bundle-defaults": "0.10.6",
    "@metaplex-foundation/umi-web3js-adapters": "0.10.6",
    "@metaplex-foundation/mpl-token-metadata": "3.1.0",
    "@metaplex-foundation/mpl-candy-machine": "6.0.1",
    "@metaplex-foundation/mpl-toolbox": "0.10.6"
  },
  "devDependencies": {
    "esbuild": "0.19.12"
  },
  "scripts": {
    "build": "esbuild src/mint.ts --bundle --format=iife --global-name=CBSMint --target=es2020 --outfile=mint.bundle.js"
  }
}
